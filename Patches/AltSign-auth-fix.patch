+    // Only allowlisted operation names are logged, never bodies, headers, account IDs, or codes.
+    func authenticationStage(for request: URLRequest) -> String
+    {
+        switch request.url?.path
+        {
+        case "/auth/verify/trusteddevice": return "trusted-device-request"
+        case "/grandslam/GsService2/validate": return "trusted-device-validate"
+        case "/auth/verify/phone", "/auth/verify/phone/put": return "sms-request"
+        case "/auth/verify/phone/securitycode": return "sms-validate"
+        case "/grandslam/GsService2":
+            if let body = request.httpBody,
+               let plist = try? PropertyListSerialization.propertyList(from: body, format: nil) as? [String: Any],
+               let parameters = plist["Request"] as? [String: Any],
+               let operation = parameters["o"] as? String,
+               ["init", "complete", "apptokens"].contains(operation)
+            {
+                return operation
+            }
+            return "sign-in"
+        default: return "authentication"
+        }
+    }
