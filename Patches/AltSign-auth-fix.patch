+import Foundation
+
+public struct AuthenticationSessionScope: Codable, Equatable {
+    public let account: String
+    public let deviceID: String
+    public let clientInfo: String
+    public init(account: String, deviceID: String, clientInfo: String) {
+        self.account = account.lowercased()
+        self.deviceID = deviceID
+        self.clientInfo = clientInfo
+    }
+}
+
+// Only the local, non-synchronizing keychain stores this record. Never store anisette OTPs.
+public struct AuthenticationSessionCredential: Codable, CustomStringConvertible, CustomDebugStringConvertible {
+    public let schema: Int
+    public let scope: AuthenticationSessionScope
+    public let dsid: String
+    public let token: String
+    public let issuedAt: Date
+    public let expiresAt: Date
+    public var description: String { "<AuthenticationSessionCredential: redacted>" }
+    public var debugDescription: String { description }
+
+    public init(scope: AuthenticationSessionScope, dsid: String, token: String, issuedAt: Date, serverExpiry: Date?) {
+        self.schema = 1
+        self.scope = scope
+        self.dsid = dsid
+        self.token = token
+        self.issuedAt = issuedAt
+        // Respect Apple's expiry, cap local retention at seven days; absent expiry gets 15 minutes.
+        self.expiresAt = min(serverExpiry ?? issuedAt.addingTimeInterval(900), issuedAt.addingTimeInterval(7 * 86400))
+    }
+    public func isUsable(for scope: AuthenticationSessionScope, now: Date) -> Bool {
+        schema == 1 && self.scope == scope && !scope.account.isEmpty && !scope.deviceID.isEmpty &&
+        !scope.clientInfo.isEmpty && !dsid.isEmpty && !token.isEmpty &&
+        issuedAt.timeIntervalSince1970.isFinite && expiresAt.timeIntervalSince1970.isFinite &&
+        issuedAt <= now.addingTimeInterval(5) && expiresAt > now.addingTimeInterval(60) &&
+        expiresAt <= issuedAt.addingTimeInterval(7 * 86400)
+    }
+}
+
+// Serializes authentication decisions across independent Refresh groups. A queued request reads
+// the credential saved by the previous one, then validates it using its own fresh anisette data.
+// No successful result is returned until Apple validates the token or a real login succeeds.
+public final class AuthenticationSessionCoordinator<Value> {
+    private let queue = DispatchQueue(label: "AltSign.AuthenticationSessionReuse")
+    private var pending: [() -> Void] = []
+    private var running = false
+
+    public init() {}
+
+    public func resolve(scope: AuthenticationSessionScope, allowsCachedSession: Bool,
+                        now: @escaping () -> Date = Date.init,
+                        load: @escaping () -> Data?, persist: @escaping (Data?) -> Bool,
+                        isCurrent: @escaping () -> Bool,
+                        isInvalidSession: @escaping (Error) -> Bool,
+                        validate: @escaping (AuthenticationSessionCredential, @escaping (Result<Value, Error>) -> Void) -> Void,
+                        login: @escaping (@escaping (Result<Value, Error>) -> Void) -> Void,
+                        credential: @escaping (Value) -> AuthenticationSessionCredential,
+                        completion: @escaping (Result<Value, Error>) -> Void) {
+        queue.async {
+            self.pending.append {
+                // Every state transition and completion gate is owned by this serial queue.
+                var phase = "starting"
+                func finish(_ result: Result<Value, Error>) {
+                    guard phase != "finished" else { return }
+                    phase = "finished"
+                    self.running = false
+                    completion(isCurrent() ? result : .failure(CancellationError()))
+                    self.startNext()
+                }
+                func performLogin() {
+                    guard isCurrent() else { return finish(.failure(CancellationError())) }
+                    phase = "login"
+                    login { result in
+                        self.queue.async {
+                            guard phase == "login" else { return }
+                            guard isCurrent() else { return finish(.failure(CancellationError())) }
+                            if case .success(let value) = result {
+                                let record = credential(value)
+                                let data = record.isUsable(for: scope, now: now()) ? try? JSONEncoder().encode(record) : nil
+                                guard persist(data) else { return finish(.failure(CancellationError())) }
+                            }
+                            finish(result)
+                        }
+                    }
+                }
+                guard isCurrent() else { return finish(.failure(CancellationError())) }
+                guard allowsCachedSession, let data = load() else { return performLogin() }
+                guard data.count <= 65536,
+                      let saved = try? JSONDecoder().decode(AuthenticationSessionCredential.self, from: data),
+                      saved.isUsable(for: scope, now: now()) else {
+                    guard persist(nil) else { return finish(.failure(CancellationError())) }
+                    return performLogin()
+                }
+                phase = "validation"
+                validate(saved) { result in
+                    self.queue.async {
+                        guard phase == "validation" else { return }
+                        guard isCurrent() else { return finish(.failure(CancellationError())) }
+                        switch result {
+                        case .success: finish(result)
+                        case .failure(let error) where isInvalidSession(error):
+                            // Exactly one new login after an explicit expired/unauthorized session.
+                            guard persist(nil) else { return finish(.failure(CancellationError())) }
+                            performLogin()
+                        case .failure: finish(result) // 503/offline/permissions do not trigger password login.
+                        }
+                    }
+                }
+            }
+            self.startNext()
+        }
+    }
+
+    private func startNext() {
+        guard !running, !pending.isEmpty else { return }
+        running = true
+        pending.removeFirst()()
+    }
+}
